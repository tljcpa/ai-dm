# 复制本文件为 .env 并填入真实值
# .env 已在 .gitignore，绝不入库

# JWT 签名密钥（生产环境必须用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# JWT 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库 URL（SQLite 文件路径）
DATABASE_URL=sqlite:///./app.db

# === LLM Provider API Keys ===
# Day 2 已接入 Deepseek + Zhipu，做主备路由（亮点 ④）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=

# 路由主备配置（primary 调用，失败时切 backup）
LLM_PRIMARY=deepseek
LLM_BACKUP=zhipu

DEFAULT_CLAUDE_MODEL=claude-opus-4-7
DEFAULT_DEEPSEEK_MODEL=deepseek-chat
DEFAULT_ZHIPU_MODEL=glm-4-flash

# CORS 允许的前端 origin（开发期）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
