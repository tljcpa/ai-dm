# 复制本文件为 .env 并填入真实值
# .env 已在 .gitignore，绝不入库

# JWT 签名密钥（生产环境必须用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# JWT 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库 URL（SQLite 文件路径）
DATABASE_URL=sqlite:///./app.db

# === LLM Provider API Keys ===
# Day 1 末期已接入 Deepseek，其余 Provider Day 2 加
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# 默认 LLM 选择：mock / deepseek / claude / openai / gemini
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_CLAUDE_MODEL=claude-opus-4-7
DEFAULT_DEEPSEEK_MODEL=deepseek-chat

# CORS 允许的前端 origin（开发期）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
