server {
    server_name aidm.zdwktlj.top;

    # 前端静态文件（Vite build 产物）
    location / {
        root /var/www/ai-dm;
        index index.html;
        # SPA fallback：前端路由（/auth /game 等）刷新时返回 index.html
        try_files $uri $uri/ /index.html;
    }

    # 后端 API：去掉 /api 前缀转发给 uvicorn :9001
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:9001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # LLM 单回合可能 5-15s（含 RAG embed + 摘要回合），加长超时
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # 禁用 buffer 便于未来扩展 SSE 流式
        proxy_buffering off;
        proxy_request_buffering off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/aidm.zdwktlj.top/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/aidm.zdwktlj.top/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = aidm.zdwktlj.top) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name aidm.zdwktlj.top;
    return 404; # managed by Certbot


}