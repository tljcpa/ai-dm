[Unit]
Description=AI Dungeon Master Backend (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-dm
EnvironmentFile=/root/ai-dm/.env
ExecStart=/root/ai-dm/venv/bin/uvicorn main:app --host 127.0.0.1 --port 9001 --workers 1
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
